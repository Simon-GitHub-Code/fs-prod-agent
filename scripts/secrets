#!/usr/bin/env bash
# Secret scan. Pre-push and CI run this same command.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not on PATH. CI runs this scan with gitleaks 8.30.1." >&2
  exit 1
fi
gitleaks detect --redact --no-banner --exit-code 1
