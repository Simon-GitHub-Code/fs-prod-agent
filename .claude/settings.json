{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__agor"
    ]
  },
  "skillOverrides": {
    "close-out": "off",
    "codex-plan-review": "off",
    "explore": "off",
    "grill": "off",
    "handoff": "off",
    "impl-plan": "off",
    "implement": "off",
    "issue-style": "off",
    "plan-issue": "off",
    "quadra-workspace": "off",
    "research-note": "off",
    "shape-issue": "off",
    "source-review": "off",
    "to-tasks": "off",
    "verify": "off",
    "work-issue": "off",
    "work-queue": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/context/hooks/session_start.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/context/hooks/session_start.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.grok/hooks/approval.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/context/hooks/pre_push_gate.py\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/context/hooks/post_edit_complexity.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
