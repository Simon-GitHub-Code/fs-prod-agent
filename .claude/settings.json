{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__agor"
    ]
  },
  "skillOverrides": {
    "close-out": "off",
    "codex-plan-review": "off",
    "explore": "off",
    "grill": "off",
    "handoff": "off",
    "impl-plan": "off",
    "implement": "off",
    "issue-style": "off",
    "plan-issue": "off",
    "quadra-workspace": "off",
    "research-note": "off",
    "shape-issue": "off",
    "source-review": "off",
    "to-tasks": "off",
    "verify": "off",
    "work-issue": "off",
    "work-queue": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.grok/hooks/approval.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.grok/hooks/context_pack.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.grok/hooks/fitness_stop.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.grok/hooks/fitness_stop.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
